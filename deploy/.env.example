# Variables de entorno para producción (EC2).
# Copia este archivo a `deploy/.env` en la EC2 y rellena los valores.
# NO subas el .env real a Git.

# Clave secreta de Django (genera una nueva, larga y aleatoria):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# En producción SIEMPRE False.
DJANGO_DEBUG=False

# Dominio(s) desde los que se sirve, separados por coma.
DJANGO_ALLOWED_HOSTS=milesdepuntos.com,www.milesdepuntos.com,51.21.117.59

# Servir bajo la subruta /sorare del dominio (milesdepuntos.com/sorare).
# Déjalo vacío o quita la línea si algún día lo sirves en la raíz.
DJANGO_FORCE_SCRIPT_NAME=/sorare

# Orígenes de confianza para CSRF (tu dominio con https).
DJANGO_CSRF_TRUSTED_ORIGINS=https://www.milesdepuntos.com,https://milesdepuntos.com

# Como milesdepuntos ya va por HTTPS, deja esto en true.
DJANGO_SECURE_COOKIES=true
